{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-canary",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CANARY",
      "id": "00000000000000000000000000000000"
    }
  ]
}
